import java.util.*;
class Practice2 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        PriorityQueue<Integer> pq=new PriorityQueue<>();
        for(int i=0;i<n;i++){
            pq.add(sc.nextInt());
        }
        int j=0;
        while(!pq.isEmpty() && j<5){
            int x=pq.remove();
            System.out.print(x+" ");
            j++;
        }
    }
}
