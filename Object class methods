class Point1{
    int x,y;
    public Point1(int x,int y){
        this.x=x;
        this.y=y;
    }
    public String toString(){
        return "My Point as string("+x+","+y+")";
    }
}
class Box1 extends Object{//Object class is super class of all objects
    public void finalize(){//when we have less space object is removed from memeory in the backend compiler calls finalize 
        System.out.println("Box removed from memory");
    }
}
class OpenBox1 extends Box1{

}

