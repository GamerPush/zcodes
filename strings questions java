import java.util.Scanner;
class Practice1 {
    public static void main(String args[]){
        Scanner in=new Scanner(System.in);
        String s1=in.nextLine();
        String s2=in.next();
        System.out.println(commonPrefix(s1, s2));
        highlightName(s1);
        
    }

    static String commonPrefix(String s1,String s2) {
        //String prefix=""; //in this method we are creating multiple objects t th not optimal for memory
        StringBuilder sb=new StringBuilder();
        for (int i = 0; i <Math.min(s1.length(),s2.length()); i++) {
            if(s1.charAt(i)==s2.charAt(i))
                sb.append(s1.charAt(i)); //prefix+=s1.charAt(i);
            else
                break;
        }
        return sb.toString();
    }

    static void highlightName(String s1){ //Pushkar Goyal->PG
        StringBuilder sb=new StringBuilder();
        sb.append(s1.charAt(0));
        for(int i=0;i<s1.length();i++){
            if(s1.charAt(i)==' ')
                continue;
            else if(Character.isUpperCase(s1.charAt(i)))
                sb.append(s1.charAt(i));
        }
        sb.toString();
        System.out.println(""+sb.charAt(0)+sb.charAt(sb.length()-1));
    }
}
